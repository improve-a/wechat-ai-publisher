{
  "name": "wechat-ai-publisher",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:m1": "tsx scripts/check-m1.ts",
    "check:m2": "vitest run tests/m2",
    "check:m3": "vitest run tests/m3",
    "check:m3:live": "node --env-file=.env.local --import tsx scripts/run-live-ai-acceptance.ts",
    "check:editorial:v2:live": "node --env-file=.env.local --import tsx scripts/run-editorial-v2-live-acceptance.ts",
    "check:m4": "vitest run tests/m4",
    "check:m5": "vitest run tests/m5",
    "check:m5:browser": "python scripts/m5_visual_gate.py",
    "check:m3:live:browser": "python scripts/live_ai_visual_gate.py",
    "check:live-ai": "npm run check:m3:live && npm run check:m3:live:browser",
    "check:m3-m5:core": "vitest run tests/m3 tests/m4 tests/m5 tests/integration",
    "check:m3-m5": "npm run check:m3-m5:core && npm run check:m5:browser && npm run check:editorial:all",
    "check:editorial": "vitest run tests/editorial",
    "check:editorial:browser": "python scripts/editorial_visual_gate.py",
    "check:editorial:v2:browser": "python scripts/editorial_visual_gate_v2.py",
    "check:editorial:v2": "vitest run tests/editorial/art-direction-v2.test.ts",
    "export:editorial:v2": "tsx scripts/export-editorial-v2-artifacts.ts",
    "check:editorial:v2:all": "npm run check:editorial:v2 && npm run check:editorial:v2:browser && npm run export:editorial:v2",
    "check:visual-patterns": "vitest run tests/editorial/visual-patterns.test.ts",
    "check:visual-pattern-repetition": "vitest run tests/editorial/visual-pattern-repetition.test.ts",
    "check:live-contract": "vitest run tests/editorial/live-contract.test.ts",
    "check:section-numbering": "vitest run tests/editorial/final-visual-refinement.test.ts -t \"numbering policy\"",
    "check:reading-rhythm": "vitest run tests/editorial/final-visual-refinement.test.ts -t \"segments long\"",
    "check:article-coherence": "vitest run tests/editorial/final-visual-refinement.test.ts -t \"article grammars distinct\"",
    "check:real-photo-stress": "vitest run tests/editorial/real-photo-stress.test.ts",
    "check:visual-refinement": "vitest run tests/editorial/final-visual-refinement.test.ts tests/editorial/real-photo-stress.test.ts && python scripts/final_visual_refinement_gate.py",
    "check:editorial:all": "npm run check:editorial && npm run check:editorial:browser && npm run check:editorial:v2:browser",
    "preview": "vite preview"
  },
  "dependencies": {
    "parse5": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
